# Apply to configs/verified-20261015/client.config for the RMM transport.
CONFIG_REALM_XSHM=y
CONFIG_CMA_SIZE_MBYTES=320
CONFIG_PROXY_VMSHM_COMM=y
CONFIG_PROXY_VMSHM_COMM_HELLO_SELFTEST=y
CONFIG_CLIENT_VMSHM_COMM_HELLO_SELFTEST=y
