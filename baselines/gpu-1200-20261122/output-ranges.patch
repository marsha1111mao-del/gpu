+static void invalidate_outputs(const unsigned char *shared,
+			       const struct gpu_firmware_output_range *ranges,
+			       unsigned int count)
+{
+	unsigned long ctr;
+
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r" (ctr));
+	if ((4U << ((ctr >> 16U) & 15U)) != GPU_FIRMWARE_CACHE_LINE) {
+		for (unsigned int i = 0U; i < count; i++)
+			invalidate(shared + ranges[i].offset, ranges[i].size);
+		return;
+	}
+	/* Each discovered output begins on its own line. No load or device
+	 * access crosses the common completion barrier.
+	 */
+	for (unsigned int i = 0U; i < count; i++) {
+		uintptr_t line = (uintptr_t)shared + ranges[i].offset;
+		uintptr_t end = line + ranges[i].size;
+
+		for (; line < end; line += GPU_FIRMWARE_CACHE_LINE)
+			__asm__ volatile ("dc ivac, %0" :: "r" (line) : "memory");
+	}
+	dsb(sy);
+}
